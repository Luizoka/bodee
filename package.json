{
  "name": "fatura-sync",
  "version": "1.0.7",
  "private": true,
  "description": "Automação independente para coleta de faturas de energia.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:extension": "node scripts/build-extension.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "poc:equatorial": "tsx src/cli/equatorial-poc.ts",
    "poc:offline": "tsx src/cli/equatorial-offline.ts",
    "api": "tsx src/api/main.ts",
    "worker:offline": "tsx src/cli/process-offline-sync.ts",
    "worker:sync": "tsx src/cli/process-offline-sync.ts",
    "test:worker:recovery": "tsx src/cli/worker-recovery-test.ts",
    "scheduler:monthly": "tsx src/cli/schedule-monthly-syncs.ts",
    "test:api:flow": "tsx src/cli/api-flow-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:equatorial": "tsx src/cli/equatorial-poc.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/swagger": "^11.4.6",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.15.9"
}
