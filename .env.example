# URLs públicas; não coloque dados reais de clientes neste arquivo.
EQUATORIAL_PORTAL_URL=https://pa.equatorialenergia.com.br/siteantigo
EQUATORIAL_API_URL=https://api-pa-cliente.equatorialenergia.com.br

# Preencha somente no arquivo .env local, que é ignorado pelo Git.
EQUATORIAL_DOCUMENT=
EQUATORIAL_BIRTH_DATE=
EQUATORIAL_ACCOUNT=
# Opcional: várias contas contrato separadas por vírgula. Se omitido, usa EQUATORIAL_ACCOUNT.
EQUATORIAL_ACCOUNTS=
# Use somente uma das três opções abaixo: competência única, lista ou intervalo.
EQUATORIAL_COMPETENCE=2026/08
# EQUATORIAL_COMPETENCES=2026/08,2026/07,2026/06
# O intervalo é inclusivo e respeita a ordem informada, inclusive do mês mais novo para o mais antigo.
# EQUATORIAL_COMPETENCE_START=2026/08
# EQUATORIAL_COMPETENCE_END=2025/11

# No primeiro deploy Render, valide apenas a infraestrutura do Chromium.
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=60000
PLAYWRIGHT_BROWSER_CHANNEL=chromium
PLAYWRIGHT_PERSISTENT_CONTEXT=false
PLAYWRIGHT_USER_DATA_DIR=output/browser-profile
EQUATORIAL_API_TIMEOUT_MS=30000
POC_OUTPUT_DIR=output/equatorial
# Desenvolvimento local: `docker compose up -d`. Em produção, use a URL do
# PostgreSQL do ambiente; não inclua credenciais neste arquivo.
DATABASE_URL=
API_PORT=3000
INVOICE_STORAGE_DIR=output/invoices
# 32 bytes em hexadecimal; obrigatório para a API e o worker.
CREDENTIALS_ENCRYPTION_KEY=
# Obrigatória para a API administrativa.
ADMIN_API_KEY=
# Configuração do worker de sincronização local.
WORKER_POLL_INTERVAL_MS=1000
WORKER_STALE_AFTER_MS=300000
WORKER_MAX_ATTEMPTS=3
# Espera entre falhas: 10s, 20s, 40s... até uma hora.
WORKER_RETRY_BASE_DELAY_MS=10000
# Use `equatorial` somente depois de habilitar a integração real do provider.
SYNC_PROVIDER=offline
# Proteção local contra abuso da API (por IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_CLIENT_MAX=120
# Defina como true somente atrás de proxy reverso confiável.
RATE_LIMIT_TRUST_PROXY=false
# Storage: mantenha local no desenvolvimento. No Render use supabase depois de
# validar API + worker; SERVICE_ROLE_KEY nunca deve ser exposta ao cliente.
INVOICE_STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVOICE_BUCKET=faturas
