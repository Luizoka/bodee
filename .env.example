# URLs públicas; não coloque dados reais de clientes neste arquivo.
EQUATORIAL_PORTAL_URL=https://pa.equatorialenergia.com.br/siteantigo
EQUATORIAL_API_URL=https://api-pa-cliente.equatorialenergia.com.br

# Preencha somente no arquivo .env local, que é ignorado pelo Git.
EQUATORIAL_DOCUMENT=
EQUATORIAL_BIRTH_DATE=
EQUATORIAL_ACCOUNT=
# Opcional: várias contas contrato separadas por vírgula. Se omitido, usa EQUATORIAL_ACCOUNT.
EQUATORIAL_ACCOUNTS=
EQUATORIAL_COMPETENCE=2026/08

# O portal bloqueou o modo headless no diagnóstico inicial. Comece com false.
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=60000
PLAYWRIGHT_BROWSER_CHANNEL=chromium
PLAYWRIGHT_PERSISTENT_CONTEXT=false
PLAYWRIGHT_USER_DATA_DIR=output/browser-profile
EQUATORIAL_API_TIMEOUT_MS=30000
POC_OUTPUT_DIR=output/equatorial
# Desenvolvimento local: `docker compose up -d`.
# Em produção, substitua pela URL do PostgreSQL do ambiente.
DATABASE_URL=postgresql://fatura_sync:fatura_sync@localhost:5432/fatura_sync
API_PORT=3000
# 32 bytes em hexadecimal; obrigatório para a API.
# Esta chave é exclusiva para desenvolvimento local; nunca a reutilize em produção.
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Obrigatória para cadastrar clientes e emitir/revogar API keys.
# Altere este valor antes de qualquer ambiente que não seja local.
ADMIN_API_KEY=fatura-sync-local-admin-8bd14e7c25fa6093e4b7
