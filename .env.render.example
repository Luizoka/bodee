# Cadastre estas variáveis no painel do Render. Não envie um arquivo .env real.
ADMIN_API_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# O container usa uma tela virtual (Xvfb) para evitar o bloqueio do modo headless.
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_BROWSER_CHANNEL=chromium
PLAYWRIGHT_TIMEOUT_MS=60000
EQUATORIAL_API_TIMEOUT_MS=30000

# Opcionais: os endereços padrão já são usados quando estas linhas não existem.
EQUATORIAL_PORTAL_URL=https://pa.equatorialenergia.com.br/siteantigo
EQUATORIAL_API_URL=https://api-pa-cliente.equatorialenergia.com.br

# Não configure DATABASE_URL nem CREDENTIALS_ENCRYPTION_KEY no modo sem banco.
